<div class="auth-caixa">

  {{#each errors}}
    <div class="alerta alerta-erro">⚠️ {{this}}</div>
  {{/each}}
  {{#each success}}
    <div class="alerta alerta-sucesso">✅ {{this}}</div>
  {{/each}}

  <form action="/login" method="POST">
    <div class="auth-campos">
      <div class="auth-campo">
        <label for="email">E-mail</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="seu@email.com"
          required
          autocomplete="email"
        />
      </div>
      <div class="auth-campo">
        <label for="senha">Senha</label>
        <input
          type="password"
          id="senha"
          name="senha"
          placeholder="••••••••"
          required
          autocomplete="current-password"
        />
      </div>
    </div>
    <button type="submit" class="btn-auth">Entrar</button>
  </form>

  <p class="auth-troca">Não tem conta?
    <a href="/cadastro">Cadastre-se aqui</a></p>
</div>