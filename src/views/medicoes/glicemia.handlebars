{{#each errors}}
<div class="alerta alerta-erro">⚠️ {{this}}</div>
{{/each}}

<div class="editar-header">
  <a href="/historico" class="btn-voltar">← Voltar</a>
  <h1 class="editar-titulo">Editar Glicemia</h1>
</div>

<div class="form-registro">
  <div class="form-titulo">💉 Glicemia</div>
  <form action="/medicoes/glicemia/{{editando.id}}" method="POST">
    <div class="campos-grid campos-2col">
      <div class="campo">
        <label for="valor">Glicemia (mg/dL)</label>
        <input type="number" id="valor" name="valor" value="{{editando.valor}}" min="20" max="600" step="0.1" placeholder="Ex: 95" required />
        <span class="campo-dica">Entre 20 e 600</span>
      </div>
      <div class="campo">
        <label for="dataHora">Data e Horário</label>
        <input type="datetime-local" id="dataHora" name="dataHora" value="{{dataHoraEdit}}" required />
      </div>
    </div>
    <button type="submit" class="btn-registrar">Salvar alterações</button>
  </form>
</div>
