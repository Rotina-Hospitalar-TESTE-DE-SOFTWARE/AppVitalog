{{#each errors}}
<div class="alert alert-error">{{this}}</div>
{{/each}}

<div class="page-header">
  <div>
    <h1 class="page-title">💉 {{title}}</h1>
    <p class="page-subtitle">Informe o valor da medição</p>
  </div>
  <a href="/historico" class="btn btn-outline">← Voltar</a>
</div>

<div class="form-card">
  <form action="{{#if editando}}/medicoes/glicemia/{{editando.id}}{{else}}/medicoes/glicemia{{/if}}" method="POST">
    <div class="form-section">
      <h3 class="form-section-title">Valores da Glicemia</h3>
      <div class="form-row">
        <div class="form-group">
          <label for="valor">Glicemia (mg/dL) *</label>
          <input type="number" id="valor" name="valor"
            value="{{#if editando}}{{editando.valor}}{{/if}}"
            min="20" max="600" step="0.1" placeholder="Ex: 95" required />
          <span class="form-hint">Intervalo permitido: 20 – 600 mg/dL</span>
        </div>
        <div class="form-group">
          <label for="dataHora">Data e Horário *</label>
          <input type="datetime-local" id="dataHora" name="dataHora"
            value="{{#if editando}}{{dataHoraEdit}}{{else}}{{dataHoraAtual}}{{/if}}" required />
        </div>
      </div>
      <div class="form-group">
        <label for="observacao">Observação</label>
        <input type="text" id="observacao" name="observacao"
          value="{{#if editando}}{{editando.observacao}}{{/if}}"
          placeholder="Ex: em jejum, pós-prandial, antes da insulina..." />
      </div>
    </div>

    <div class="pressao-ref">
      <h4>Referência de classificação</h4>
      <div class="ref-grid">
        <div class="ref-item ref-hipo">Hipoglicemia: &lt;70 mg/dL</div>
        <div class="ref-item ref-normal">Normal: 70–99 mg/dL</div>
        <div class="ref-item ref-pre">Pré-diabetes: 100–125 mg/dL</div>
        <div class="ref-item ref-diabetes">Diabetes: ≥126 mg/dL</div>
      </div>
    </div>

    <div class="form-actions">
      <a href="/historico" class="btn btn-outline">Cancelar</a>
      <button type="submit" class="btn btn-primary">
        {{#if editando}}Salvar alterações{{else}}Registrar medição{{/if}}
      </button>
    </div>
  </form>
</div>
