{{#each errors}}
<div class="alerta alerta-erro">⚠️ {{this}}</div>
{{/each}}

<div class="editar-header">
  <a href="/historico" class="btn-voltar">← Voltar</a>
  <h1 class="editar-titulo">Editar Pressão Arterial</h1>
</div>

<div class="form-registro">
  <div class="form-titulo">🩸 Pressão Arterial</div>
  <form action="/medicoes/pressao/{{editando.id}}" method="POST">
    <div class="campos-grid campos-2col">
      <div class="campo">
        <label for="sistolico">Pressão Sistólica (mmHg)</label>
        <input type="number" id="sistolico" name="sistolico" value="{{editando.sistolico}}" min="60" max="300" placeholder="Ex: 120" required />
        <span class="campo-dica">Entre 60 e 300</span>
      </div>
      <div class="campo">
        <label for="diastolico">Pressão Diastólica (mmHg)</label>
        <input type="number" id="diastolico" name="diastolico" value="{{editando.diastolico}}" min="40" max="200" placeholder="Ex: 80" required />
        <span class="campo-dica">Entre 40 e 200</span>
      </div>
    </div>
    <div class="campos-grid">
      <div class="campo">
        <label for="dataHora">Data e Horário</label>
        <input type="datetime-local" id="dataHora" name="dataHora" value="{{dataHoraEdit}}" required />
      </div>
    </div>
    <button type="submit" class="btn-registrar">Salvar alterações</button>
  </form>
</div>
