{{#each errors}}
<div class="alerta alerta-erro">⚠️ {{this}}</div>
{{/each}}
{{#each success}}
<div class="alerta alerta-sucesso">✅ {{this}}</div>
{{/each}}

<div class="historico-header">
  <div>
    <h1 class="historico-titulo">Histórico</h1>
    <p class="historico-info">Últimos 30 dias — {{totalMedicoes}} registro(s)</p>
  </div>
</div>

{{#if medicoes}}
<div class="lista-medicoes">
  {{#each medicoes}}
  <div class="card-medicao tipo-{{tipo}}">
    <div class="card-esquerda">
      <div class="card-icone {{#if (eq tipo 'pressao')}}icone-pressao{{else}}icone-glicemia{{/if}}">
        {{#if (eq tipo 'pressao')}}🩸{{else}}💉{{/if}}
      </div>
      <div class="card-info">
        <div class="card-tipo">{{#if (eq tipo 'pressao')}}Pressão Arterial{{else}}Glicemia{{/if}}</div>
        <div class="card-valor">
          {{#if (eq tipo 'pressao')}}
            {{sistolico}}/{{diastolico}}<span>mmHg</span>
          {{else}}
            {{valor}}<span>mg/dL</span>
          {{/if}}
        </div>
        <div class="card-data">📅 {{dataFormatada}}</div>
      </div>
    </div>
    <div class="card-direita">
      <span class="badge-classif badge-{{classificacao.cls}}">{{classificacao.label}}</span>
      <div class="acoes-card">
        <a href="/medicoes/{{tipo}}/{{id}}/editar" class="btn-acao" title="Editar">✏️</a>
        <button class="btn-acao btn-excluir" title="Excluir" onclick="confirmarExclusao('{{id}}')">🗑️</button>
      </div>
    </div>
  </div>
  {{/each}}
</div>
{{else}}
<div class="vazio">
  <div class="vazio-icone">📋</div>
  <h2>Nenhuma medição encontrada</h2>
  <p>Você ainda não registrou medições nos últimos 30 dias.</p>
  <a href="/registrar" class="btn-auth" style="display:inline-block;padding:1rem 2rem;text-decoration:none;border-radius:12px;font-weight:800;">Registrar agora</a>
</div>
{{/if}}

<!-- Modal exclusão -->
<div id="modalExclusao" class="modal-fundo" style="display:none">
  <div class="modal">
    <div class="modal-icone">🗑️</div>
    <h3>Excluir medição?</h3>
    <p>Esta ação é permanente e não pode ser desfeita.</p>
    <div class="modal-acoes">
      <button onclick="cancelarExclusao()" class="btn-cancelar">Cancelar</button>
      <form id="formExclusao" method="POST" style="flex:1">
        <button type="submit" class="btn-confirmar-excluir" style="width:100%">Excluir</button>
      </form>
    </div>
  </div>
</div>
