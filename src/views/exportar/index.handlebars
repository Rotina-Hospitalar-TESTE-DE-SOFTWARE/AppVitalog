{{#each errors}}
<div class="alerta alerta-erro">⚠️ {{this}}</div>
{{/each}}
{{#each success}}
<div class="alerta alerta-sucesso">✅ {{this}}</div>
{{/each}}

<h1 class="exportar-titulo">Exportar Histórico</h1>
<p class="exportar-subtitulo">Escolha o formato e o período para gerar o relatório</p>

<div class="exportar-grid">
  <div class="exportar-card">
    <div class="exportar-card-topo">
      <div class="exportar-icone-bg icone-pdf">📄</div>
      <div>
        <h2>Exportar PDF</h2>
        <p>Relatório para consultas médicas</p>
      </div>
    </div>
    <form action="/exportar/pdf" method="POST">
      <div class="campo-select">
        <label for="periodoPdf">Período</label>
        <select name="periodo" id="periodoPdf">
          <option value="7">Últimos 7 dias</option>
          <option value="15">Últimos 15 dias</option>
          <option value="30" selected>Últimos 30 dias</option>
          <option value="365">Últimos 12 meses</option>
        </select>
      </div>
      <br>
      <button type="submit" class="btn-baixar-pdf">📄 Baixar PDF</button>
    </form>
  </div>

  <div class="exportar-card">
    <div class="exportar-card-topo">
      <div class="exportar-icone-bg icone-excel">📊</div>
      <div>
        <h2>Exportar Planilha</h2>
        <p>Arquivo Excel para análise</p>
      </div>
    </div>
    <form action="/exportar/excel" method="POST">
      <div class="campo-select">
        <label for="periodoExcel">Período</label>
        <select name="periodo" id="periodoExcel">
          <option value="7">Últimos 7 dias</option>
          <option value="15">Últimos 15 dias</option>
          <option value="30" selected>Últimos 30 dias</option>
          <option value="365">Últimos 12 meses</option>
        </select>
      </div>
      <br>
      <button type="submit" class="btn-baixar-excel">📊 Baixar Planilha</button>
    </form>
  </div>
</div>
